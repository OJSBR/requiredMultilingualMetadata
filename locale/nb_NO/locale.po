#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.displayName"
msgstr "Påkrevde flerspråklige metadata"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.description"
msgstr "Lar tidsskriftet kreve tittel og sammendrag på flere språk, i tillegg til innsendingens primærspråk. Som standard krever OJS disse metadataene bare på språket forfatteren valgte for innsendingen."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.description"
msgstr "Velg språkene der tittel og sammendrag må fylles ut for at en innsending skal kunne fullføres. Listen viser språkene for innsendingsmetadata som er aktivert for dette tidsskriftet (Innstillinger > Språk)."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.notice.title"
msgstr "Slik brukes regelen"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.notice.body"
msgstr "Primærspråket for hver innsending kreves allerede av OJS selv – å velge det her endrer ingenting. Kravet gjelder den som sender inn: tidsskriftsledere og redaktører blokkeres ikke mens de arbeider med en annens innsending, slik at ufullstendige eldre metadata kan beholdes; men en leder som sender inn sin egen artikkel, omfattes av regelen som enhver forfatter. Hvis seksjonen er satt til «Sammendrag ikke påkrevd», forblir sammendraget valgfritt på alle språk."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.column.language"
msgstr "Metadataspråk"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.defaultTag"
msgstr "tidsskriftets standard"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.hint"
msgstr "I innsendingsveiviseren åpnes fanene for de påkrevde språkene automatisk, slik at forfatteren aldri får en feilmelding om et felt vedkommende ikke ser."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.noLocales"
msgstr "Dette tidsskriftet har ingen språk for innsendingsmetadata konfigurert. Aktiver dem under Innstillinger > Nettsted/Tidsskrift > Språk før du bruker dette tillegget."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.error.required"
msgstr "Dette tidsskriftet krever også dette feltet på {$language}."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.field.notice"
msgstr "Også påkrevd på: {$languages}"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.inactive"
msgstr "inaktiv"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.keywordsOff.title"
msgstr "Nøkkelordkolonnen er inaktiv"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.keywordsOff.body"
msgstr "Nøkkelord er bare påkrevd på språkene som er merket av her, når tidsskriftet gjør dem obligatoriske under Arbeidsflyt > Metadata > Nøkkelord = «Påkrevd». Ved enhver annen innstilling beholdes avkrysningene i denne kolonnen, men de blokkerer ingen."
