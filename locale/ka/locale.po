#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.displayName"
msgstr "სავალდებულო მრავალენოვანი მეტამონაცემები"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.description"
msgstr "საშუალებას აძლევს ჟურნალს, სათაური და აბსტრაქტი მოითხოვოს დამატებით ენებზეც, წარდგინების ძირითადი ენის გარდა. ნაგულისხმევად OJS ამ მეტამონაცემებს მოითხოვს მხოლოდ იმ ენაზე, რომელიც ავტორმა წარდგინებისთვის აირჩია."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.description"
msgstr "აირჩიეთ ენები, რომლებზეც სათაური და აბსტრაქტი უნდა შეივსოს, რომ წარდგინება დასრულდეს. სიაში ჩანს ამ ჟურნალისთვის ჩართული წარდგინების მეტამონაცემების ენები (პარამეტრები > ენები)."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.notice.title"
msgstr "როგორ მოქმედებს წესი"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.notice.body"
msgstr "თითოეული წარდგინების ძირითად ენას თავად OJS უკვე მოითხოვს — აქ მისი მონიშვნა არაფერს ცვლის. მოთხოვნა ვრცელდება იმაზე, ვინც წარადგენს: ჟურნალის მენეჯერები და რედაქტორები არ ბლოკირდებიან სხვისი წარდგინებაზე მუშაობისას, ამიტომ ძველი არასრული მეტამონაცემები შენარჩუნებადია; თუმცა მენეჯერი, რომელიც საკუთარ სტატიას წარადგენს, წესს ისევე ექვემდებარება, როგორც ნებისმიერი ავტორი. თუ სექცია დაყენებულია როგორც „აბსტრაქტი არ არის სავალდებულო“, აბსტრაქტი ყველა ენაზე არჩევითი რჩება."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.column.language"
msgstr "მეტამონაცემების ენა"

