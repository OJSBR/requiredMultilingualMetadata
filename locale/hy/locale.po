#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.displayName"
msgstr "Պարտադիր բազմալեզու մետատվյալներ"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.description"
msgstr "Թույլ է տալիս ամսագրին պահանջել վերնագիր և ամփոփում լրացուցիչ լեզուներով՝ ներկայացման հիմնական լեզվից բացի։ Կանխադրված OJS-ը այս մետատվյալները պահանջում է միայն այն լեզվով, որը հեղինակն ընտրել է ներկայացման համար։"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.description"
msgstr "Ընտրեք լեզուները, որոնցով պետք է լրացվեն վերնագիրը և ամփոփումը, որպեսզի ներկայացումն ավարտվի։ Ցանկը ցույց է տալիս այս ամսագրի համար միացված ներկայացման մետատվյալների լեզուները (Կարգավորումներ > Լեզուներ)։"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.notice.title"
msgstr "Ինչպես է կիրառվում կանոնը"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.notice.body"
msgstr "Յուրաքանչյուր ներկայացման հիմնական լեզուն արդեն պահանջվում է հենց OJS-ի կողմից — այստեղ ընտրելը ոչինչ չի փոխում։ Պահանջը վերաբերում է նրան, ով ներկայացնում է. ամսագրի կառավարիչներն ու խմբագիրները չեն արգելափակվում ուրիշի ներկայացման վրա աշխատելիս, ուստի հին թերի մետատվյալները կարող են պահպանվել. սակայն սեփական հոդվածը ներկայացնող կառավարիչը ենթարկվում է կանոնին ինչպես ցանկացած հեղինակ։ Եթե բաժինը սահմանված է «Ամփոփումը պարտադիր չէ», ամփոփումը մնում է ընտրովի բոլոր լեզուներով։"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.column.language"
msgstr "Մետատվյալների լեզու"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.defaultTag"
msgstr "ամսագրի կանխադրվածը"

#, fuzzy
