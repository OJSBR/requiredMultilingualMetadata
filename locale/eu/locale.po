#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.displayName"
msgstr "Nahitaezko metadatu eleaniztunak"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.description"
msgstr "Aldizkariari izenburua eta laburpena hizkuntza gehiagotan eskatzeko aukera ematen dio, bidalketaren hizkuntza nagusiaz gain. Lehenespenez, OJSk metadatu horiek egileak bidalketarako aukeratutako hizkuntzan bakarrik eskatzen ditu."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.description"
msgstr "Aukeratu zein hizkuntzatan bete behar diren izenburua eta laburpena bidalketa osatu ahal izateko. Zerrendak aldizkari honetan gaituta dauden bidalketa-metadatuen hizkuntzak erakusten ditu (Ezarpenak > Hizkuntzak)."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.notice.title"
msgstr "Nola aplikatzen den araua"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.notice.body"
msgstr "Bidalketa bakoitzaren hizkuntza nagusia OJSk berak eskatzen du jada — hemen hautatzeak ez du ezer aldatzen. Betekizuna bidalketa egiten duenari aplikatzen zaio: aldizkariko kudeatzaileak eta editoreak ez dira blokeatzen beste norbaiten bidalketan lan egitean, eta horrela lehengo metadatu osatugabeak gorde daitezke; baina bere artikulua bidaltzen duen kudeatzailea arauaren mende dago beste edozein egile bezala. Atala «Laburpena ez da beharrezkoa» gisa ezarrita badago, laburpena aukerakoa izaten jarraitzen du hizkuntza guztietan."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.column.language"
msgstr "Metadatuen hizkuntza"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.defaultTag"
msgstr "aldizkariaren lehenetsia"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.hint"
msgstr "Bidalketaren laguntzailean nahitaezko hizkuntzen fitxak automatikoki irekitzen dira; hala, egileari ez zaio inoiz ikusten ez duen eremu bateko errorerik erakusten."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.noLocales"
msgstr "Aldizkari honek ez du bidalketa-metadatuen hizkuntzarik konfiguratuta. Gaitu itzazu Ezarpenak > Webgunea/Aldizkaria > Hizkuntzak atalean plugin hau erabili aurretik."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.error.required"
msgstr "Aldizkari honek eremu hori {$language} hizkuntzan ere eskatzen du."

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.field.notice"
msgstr "Honako hauetan ere beharrezkoa: {$languages}"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.inactive"
msgstr "ez-aktiboa"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.keywordsOff.title"
msgstr "Gako-hitzen zutabea ez dago aktibo"

#, fuzzy
msgid "plugins.generic.requiredMultilingualMetadata.settings.keywordsOff.body"
msgstr "Gako-hitzak hemen markatutako hizkuntzetan nahitaezkoak dira soilik aldizkariak Lan-fluxua > Metadatuak > Gako-hitzak = «Beharrezkoa» bidez derrigortzen dituenean. Beste edozein ezarpenetan, zutabe honetan markatuta dagoena gorde egiten da, baina ez du inor blokeatzen."
